{"case_id":"entra-list-001","kind":"list","category":"discovery","expect_tools":["sample___get_customer","sample___get_market_conditions","sample___get_stock_quote","sample___whoami"],"require_schemas":true,"notes":"whoami exists only when the server runs with AUTH_MODE=entra."}
{"case_id":"entra-whoami-001","tool":"sample___whoami","arguments":{},"category":"identity_passthrough","assertions":[{"type":"json_path_equals","path":"$.authenticated","value":true},{"type":"json_path_equals","path":"$.oid","value":"{{caller.oid}}"},{"type":"json_path_equals","path":"$.tid","value":"{{caller.tid}}"}],"notes":"The MCP server sees the signed-in user, not the toolbox or an app identity: the same object ID and tenant as the runner's own token."}
{"case_id":"entra-whoami-002","tool":"sample___whoami","arguments":{},"category":"identity_passthrough","assertions":[{"type":"schema","schema":{"type":"object","required":["scopes","client_app_id"],"properties":{"scopes":{"type":"array","contains":{"const":"user_impersonation"}},"client_app_id":{"type":"string","minLength":1}}}}],"notes":"A delegated token (user_impersonation scope) issued to the OAuth2 connection's client app, not an app-only token."}
{"case_id":"entra-roles-001","tool":"sample___whoami","arguments":{},"category":"authorization","assertions":[{"type":"json_path_equals","path":"$.regions_visible","value":["Europe","North America"]}],"notes":"Assumes the default roles from scripts/setup_entra.py (NorthAmerica Europe). Change the expected regions, and the denied cases below, if you assigned other roles."}
{"case_id":"entra-customer-001","tool":"sample___get_customer","arguments":{"customer_id":"C1001"},"category":"authorization_allowed","assertions":[{"type":"json_path_equals","path":"$.region","value":"North America"},{"type":"json_path_exists","path":"$.annual_contract_value_usd"}]}
{"case_id":"entra-customer-002","tool":"sample___get_customer","arguments":{"customer_id":"C1002"},"category":"authorization_allowed","assertions":[{"type":"json_path_equals","path":"$.account_manager","value":"Priya Nair"}]}
{"case_id":"entra-customer-003","tool":"sample___get_customer","arguments":{"customer_id":"C1004"},"category":"authorization_denied","assertions":[{"type":"schema","schema":{"type":"object","required":["access_denied","customer_id","region","required_roles"],"properties":{"access_denied":{"const":true},"customer_id":{"const":"C1004"},"region":{"const":"APAC"},"required_roles":{"type":"array","contains":{"const":"Customers.Read.APAC"}}},"not":{"anyOf":[{"required":["name"]},{"required":["account_manager"]},{"required":["annual_contract_value_usd"]}]}}}],"notes":"C1004 is in APAC. The denial is a normal result that names the missing role and leaks none of the customer's data."}
{"case_id":"entra-customer-004","tool":"sample___get_customer","arguments":{"name":"adventure works"},"category":"authorization_denied","assertions":[{"type":"schema","schema":{"type":"object","required":["access_denied","customer_id"],"properties":{"access_denied":{"const":true},"customer_id":{"const":"C1004"}},"not":{"anyOf":[{"required":["name"]},{"required":["account_manager"]},{"required":["annual_contract_value_usd"]}]}}}],"notes":"A name search is filtered the same way as an ID lookup."}
{"case_id":"entra-quote-001","tool":"sample___get_stock_quote","arguments":{"ticker":"ADVW"},"category":"authorization_allowed","assertions":[{"type":"json_path_equals","path":"$.ticker","value":"ADVW"},{"type":"json_path_exists","path":"$.price_usd"}],"notes":"A quote by ticker is public data, so it is not filtered by region."}
{"case_id":"entra-quote-002","tool":"sample___get_stock_quote","arguments":{"customer_id":"C1004"},"category":"authorization_denied","assertions":[{"type":"schema","schema":{"type":"object","required":["access_denied"],"properties":{"access_denied":{"const":true}},"not":{"anyOf":[{"required":["ticker"]},{"required":["price_usd"]}]}}}],"notes":"A quote by customer ID would reveal which customer the ticker belongs to, so it is filtered."}
{"case_id":"entra-market-001","tool":"sample___get_market_conditions","arguments":{"industry":"retail"},"category":"happy_path","assertions":[{"type":"json_path_equals","path":"$.outlook","value":"neutral"}],"notes":"A tool with no per-user filtering works the same through the OAuth2 connection."}
