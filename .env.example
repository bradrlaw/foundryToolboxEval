# Copy to .env (git-ignored) and fill in. Loaded by the agent target, eval runner, and deploy script.
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>
# Optional overrides
# FOUNDRY_AGENT_NAME=customer-assistant
# FOUNDRY_TOOLBOX_NAME=sample-customer-toolbox

# ASSERT judge/systematizer models (LiteLLM azure/<deployment>), Entra auth via your az login
AZURE_API_BASE=https://<foundry-resource>.openai.azure.com
ASSERT_AZURE_USE_AAD=1

# Optional: export OpenTelemetry spans (eval turns, tool calls, agent runs) to Application Insights
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
# APPLICATIONINSIGHTS_USE_AAD=1   # use az login (Entra) for ingestion if the resource disables key auth
# OTEL_SERVICE_NAME=foundry-toolbox-eval
