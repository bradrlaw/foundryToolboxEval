{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry agent + toolbox eval turn",
  "type": "object",
  "required": ["conversation_id", "turn_number", "user_message", "expected_tool_calls", "pass_criteria", "category"],
  "properties": {
    "conversation_id": {"type": "string", "minLength": 1},
    "turn_number": {"type": "integer", "minimum": 1},
    "user_message": {"type": "string", "minLength": 1},
    "expected_tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "params"],
        "properties": {
          "tool": {"type": "string", "minLength": 1},
          "params": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "ordered": {"type": "boolean", "default": false},
    "must_not_call": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "expected_response_pattern": {"type": ["string", "null"]},
    "response_must_not_match": {"type": ["string", "null"]},
    "pass_criteria": {"enum": ["tool_called_correctly", "response_matches", "both"]},
    "category": {"type": "string", "minLength": 1},
    "max_latency_ms": {"type": "integer", "minimum": 1},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
